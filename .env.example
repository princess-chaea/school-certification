# Vercel → Settings → Environment Variables 에 붙여 넣는 양식
# 값: Firebase 콘솔 → 프로젝트 설정(톱니) → 일반 → 내 앱(웹 앱) → SDK 설정 및 구성 → "구성"
# 웹에 공개되는 설정값이라 비밀값은 아니지만, 이 파일에는 값을 채워서 커밋하지 마세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=school-certification-e1a6c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=school-certification-e1a6c
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
