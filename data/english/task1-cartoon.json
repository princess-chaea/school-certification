  "note": "45문장 중 30문장 교사 확인 시 완료. 원문 오타 수정: 43번 'Not bad all all.' → 'Not bad at all.', 36번 '무슨 일이야?.' → '무슨 일이야?'",
  "items": [
    {"no": 1,  "ko": "너 하나도 안 변했네.", "en": "You haven't changed a bit."},
    {"no": 2,  "ko": "그녀는 손이 커.", "en": "She has a big heart."},
    {"no": 3,  "ko": "너무 기대된다!", "en": "I can't wait!"},
    {"no": 4,  "ko": "잘 어울려?", "en": "Do I look good?"},
    {"no": 5,  "ko": "이제 내가 살 차례야.", "en": "It's my turn to buy you something."},
    {"no": 6,  "ko": "벌써 군침이 도네.", "en": "My mouth is watering already."},
    {"no": 7,  "ko": "물은 셀프야!", "en": "Water is self-service."},
    {"no": 8,  "ko": "나 매운 음식 중독이야.", "en": "I'm addicted to spicy food."},
    {"no": 9,  "ko": "나는 다른 것도 좀 당겨.", "en": "I'm craving something else."},
    {"no": 10, "ko": "커피나 케이크는 어때?", "en": "How about coffee or cake?"},
    {"no": 11, "ko": "내 정신 좀 봐.", "en": "What's wrong with me?"},
    {"no": 12, "ko": "나는 법학을 전공하고 있어.", "en": "I'm majoring in law."},
    {"no": 13, "ko": "우리 잘 어울리는 것 같아.", "en": "I think we look good together."},
    {"no": 14, "ko": "기대를 저버리지 않는구나.", "en": "You never disappoint me."},
    {"no": 15, "ko": "날 뭘로 보는 거야!", "en": "Who do you think I am?"},
    {"no": 16, "ko": "노력 없이는 대가도 없어!", "en": "No pain, no gain!"},
    {"no": 17, "ko": "나 문구점에 잠깐 들러야 해.", "en": "I need to stop by the stationery store."},
    {"no": 18, "ko": "너 공부해야지!", "en": "You need to hit the books."},
    {"no": 19, "ko": "천상의 목소리!", "en": "A voice from heaven."},
    {"no": 20, "ko": "너 여전히 노래 잘하는구나!", "en": "You are still a fantastic singer!"},
    {"no": 21, "ko": "나 살이 좀 찐 것 같아.", "en": "I think I gained some weight."},
    {"no": 22, "ko": "화이트 데이는 처음 들어봐.", "en": "I've never heard of White Day."},
    {"no": 23, "ko": "나도 다시 어린애가 되고 싶어.", "en": "I wish I could be a kid again."},
    {"no": 24, "ko": "내 마음에서 우러나온 거야.", "en": "It's from my heart."},
    {"no": 25, "ko": "너 요즘 운동 열심히 한다며!", "en": "I heard that you're working out really hard these days!"},
    {"no": 26, "ko": "난 너 없인 못살아.", "en": "I can't live without you."},
    {"no": 27, "ko": "더 먹어.", "en": "Just dig in!"},
    {"no": 28, "ko": "널 위해서라면 뭐든지 할 수 있어.", "en": "Anything for you."},
    {"no": 29, "ko": "다행이야!", "en": "What a relief!"},
    {"no": 30, "ko": "배고파 죽겠어.", "en": "I'm starving."},
    {"no": 31, "ko": "너 정말 우유부단하구나!", "en": "You are so wishy washy!"},
    {"no": 32, "ko": "넌 참 특이해.", "en": "You are such a character."},
    {"no": 33, "ko": "기분 나쁘게 듣지 마.", "en": "No offense."},
    {"no": 34, "ko": "친구 좋다는 게 뭐야!", "en": "What are friends for?"},
    {"no": 35, "ko": "둘 사이에 뭐가 있구나.", "en": "You guys must have something going on."},
    {"no": 36, "ko": "무슨 일이야?", "en": "What's going on?"},
    {"no": 37, "ko": "너 정말 실망이다!", "en": "I'm disappointed in you!"},
    {"no": 38, "ko": "오, 된다!", "en": "Oh, it works!"},
    {"no": 39, "ko": "완전 시간 낭비야!", "en": "What a waste of time!"},
    {"no": 40, "ko": "식은 죽 먹기야!", "en": "It's a piece of cake!"},
    {"no": 41, "ko": "찬 밥 더운 밥 가릴 때가 아니야.", "en": "Beggars can't be choosers."},
    {"no": 42, "ko": "김칫국부터 마시지 마.", "en": "Don't count your chickens before they hatch."},
    {"no": 43, "ko": "이 정도면 훌륭하지.", "en": "Not bad at all."},
    {"no": 44, "ko": "너 지금 도를 넘었어.", "en": "You are crossing a line."},
    {"no": 45, "ko": "그럼 그렇지.", "en": "I get it now."}
  ]
}
