rules_version = '2';

// 학교장 인증제 (여러 학교 공용) Firestore 보안 규칙
// - 모든 학교 데이터는 schools/{schoolId}/... 아래에 있다 (schoolId = NEIS 표준학교코드)
// - 학생: 그 학교 명단(students/{이메일})에 있는 계정. 학년도(year)별로 기록 구분
// - 교사·관리자: schools/{schoolId}/staff/{uid}, 그 학교 관리자 승인(status == 'active') 후 사용
//   teacherType 'homeroom' = 담임(grade, classNo) / 'subject' = 전담·업무 담당(grades[], programs[])
// - 플랫폼 운영자: superAdmins/{uid} (학교 개설 승인)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function authEmail() { return request.auth.token.email.lower(); }
    function isSuper() { return signedIn() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid)); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ── 플랫폼 공통 ─────────────────────────────────────
    match /superAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // 교사 → 소속 학교 포인터, 학생 이메일 → 학교 색인 (Cloud Functions 전용)
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /studentIndex/{email} {
      allow read, write: if false;
    }

    match /schools/{schoolId} {
      function schoolData() { return get(/databases/$(database)/documents/schools/$(schoolId)).data; }
      function currentYear() { return schoolData().get('year', 2026); }

      function mySid() { return authEmail(); }
      function studentDoc() { return get(/databases/$(database)/documents/schools/$(schoolId)/students/$(mySid())).data; }
      function isStudent() {
        return signedIn()
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(mySid()))
          && studentDoc().active == true;
      }
      function isSelfStudent(sid) { return isStudent() && mySid() == sid; }

      function staffDoc() { return get(/databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid)).data; }
      function isStaff() {
        return signedIn()
          && exists(/databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid))
          && staffDoc().status == 'active';
      }
      function isAdmin() { return isSuper() || (isStaff() && staffDoc().role == 'admin'); }
      function isHomeroomOf(g, c) {
        let u = staffDoc();
        return u.teacherType == 'homeroom' && u.grade == g && u.classNo == c;
      }
      function isSubjectFor(g, program) {
        let u = staffDoc();
        return u.teacherType == 'subject' && g in u.grades && program in u.programs;
      }
      function canSeeClass(g, c) {
        return isAdmin() || (isStaff() && (isHomeroomOf(g, c) || (staffDoc().teacherType == 'subject' && g in staffDoc().grades)));
      }
      function canManage(g, c, program) {
        return isAdmin() || (isStaff() && (isHomeroomOf(g, c) || isSubjectFor(g, program)));
      }

      // 학교 정보(이름·로고·학교장)는 로그인 전후 화면에 쓰이므로 공개 읽기
      allow read: if true;
      allow update: if isAdmin() && onlyChanges(['name', 'shortName', 'principalName', 'logoUrl', 'sealUrl', 'studentDomain', 'updatedAt']);
      allow create, delete: if false;

      match /config/{docId} {
        allow read: if isStudent() || isStaff() || isSuper();
        allow write: if isAdmin();
      }
      match /sentenceSets/{setId} {
        allow read: if isStudent() || isStaff() || isSuper();
        allow write: if isAdmin();
      }

      // 교사·관리자 (가입 신청은 Cloud Functions 로만 생성)
      match /staff/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if false;
        // 승인 대기 중에는 본인이 소속 정보만 수정 가능
        allow update: if isAdmin()
          || (signedIn() && request.auth.uid == uid && resource.data.status == 'pending'
              && onlyChanges(['name', 'teacherType', 'grade', 'classNo', 'grades', 'programs', 'updatedAt']));
        allow delete: if isAdmin();
      }

      // 학생 명단 (현재 학년도)
      match /students/{sid} {
        allow get: if isSelfStudent(sid) || canSeeClass(resource.data.grade, resource.data.classNo);
        allow list: if isAdmin() || (isStaff() && canSeeClass(resource.data.grade, resource.data.classNo));
        allow update: if (isSelfStudent(sid) && onlyChanges(['lastLoginAt']))
          || ((isAdmin() || (isStaff() && isHomeroomOf(resource.data.grade, resource.data.classNo)))
              && onlyChanges(['name', 'number', 'active', 'note', 'updatedAt']));
        // 담임은 계정 없는 학생(1~2학년 등)을 자기 반에 직접 추가 가능 (계정 있는 학생은 관리자 CSV 등록)
        allow create: if isStaff() && isHomeroomOf(request.resource.data.grade, request.resource.data.classNo)
          && request.resource.data.email == '' && request.resource.data.year == currentYear();
        allow delete: if isAdmin() || (isStaff() && isHomeroomOf(resource.data.grade, resource.data.classNo) && resource.data.email == '');
      }

      // 활동 제출 기록
      match /submissions/{id} {
        allow get, list: if (isStudent() && resource.data.sid == mySid())
          || canManage(resource.data.grade, resource.data.classNo, resource.data.program);

        allow create: if isStudent()
          && request.resource.data.sid == mySid()
          && request.resource.data.year == currentYear()
          && request.resource.data.source == 'student'
          && request.resource.data.status == 'active'
          && request.resource.data.count == 1
          && request.resource.data.program in ['reading', 'carbon', 'english']
          && request.resource.data.grade == studentDoc().grade
          && request.resource.data.classNo == studentDoc().classNo
          && !('ai' in request.resource.data);

        // 교사 일괄 체크(태블릿 없는 학생 관찰 기록)
        allow create: if isStaff()
          && request.resource.data.source == 'teacher'
          && request.resource.data.status == 'active'
          && request.resource.data.year == currentYear()
          && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 100
          && canManage(request.resource.data.grade, request.resource.data.classNo, request.resource.data.program);

        allow update: if canManage(resource.data.grade, resource.data.classNo, resource.data.program)
          && onlyChanges(['status', 'deletedBy', 'deletedAt', 'deleteReason', 'reviewedBy', 'reviewedAt', 'teacherComment']);
        allow delete: if isAdmin();
      }

      // 영어 문장 연습 (과제 1·3)
      match /englishItems/{id} {
        allow get, list: if (isStudent() && resource.data.sid == mySid())
          || canManage(resource.data.grade, resource.data.classNo, 'english');

        allow create: if isStudent()
          && request.resource.data.sid == mySid()
          && request.resource.data.year == currentYear()
          && id == string(currentYear()) + '_' + mySid() + '_' + request.resource.data.setId + '_' + string(request.resource.data.no)
          && request.resource.data.grade == studentDoc().grade
          && request.resource.data.classNo == studentDoc().classNo
          && request.resource.data.status in ['practicing', 'ready', 'requested']
          && !('checkedBy' in request.resource.data);

        allow update: if (isStudent() && resource.data.sid == mySid()
            && resource.data.status != 'checked'
            && request.resource.data.status in ['practicing', 'ready', 'requested']
            && onlyChanges(['rounds', 'status', 'custom', 'requestedAt', 'updatedAt']))
          || (canManage(resource.data.grade, resource.data.classNo, 'english')
            && request.resource.data.status in ['checked', 'retry', 'requested']
            && onlyChanges(['status', 'checkedBy', 'checkedByName', 'checkedAt', 'teacherNote', 'updatedAt']));
        allow delete: if isAdmin();
      }

      // 학년도 보관함·AI 사용량 (Cloud Functions 전용)
      match /years/{year}/{rest=**} {
        allow read: if isStaff() || isSuper();
        allow write: if false;
      }
      match /years/{year} {
        allow read: if isStaff() || isSuper();
        allow write: if false;
      }
      match /aiUsage/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // 학교 개설 신청 (Cloud Functions 가 생성, 운영자가 승인)
    match /schoolRequests/{id} {
      allow read: if isSuper() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
  }
}
