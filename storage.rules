rules_version = '2';

// 학교별 업로드: schools/{schoolId}/uploads/{학생ID}/... (사진·녹음)
// 학교 로고·직인: schools/{schoolId}/assets/... (공개 읽기)
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    match /schools/{schoolId}/uploads/{sid}/{program}/{file} {
      function staffPath() { return /databases/(default)/documents/schools/$(schoolId)/staff/$(request.auth.uid); }
      function teachingScope(u) {
        let student = firestore.get(/databases/(default)/documents/schools/$(schoolId)/students/$(sid)).data;
        let classes = u.get('subjectClasses', []);
        return (u.get('homeroom', false) == true && u.get('grade', 0) == student.grade && u.get('classNo', 0) == student.classNo)
          || (u.get('subject', false) == true && student.grade in u.get('grades', []) && program in u.get('programs', [])
              && classes is list && (classes.size() == 0 || {'grade': student.grade, 'classNo': student.classNo} in classes));
      }
      function staffCanRead() {
        let u = firestore.get(staffPath()).data;
        return u.status == 'active' && (u.role == 'admin' || (u.role == 'teacher' && teachingScope(u)));
      }
      allow read: if (signedIn() && request.auth.token.email.lower() == sid)
        || (signedIn() && staffCanRead());
      function ticketUpload() {
        let ticket = firestore.get(/databases/(default)/documents/schools/$(schoolId)/uploadTickets/$(file)).data;
        return ticket.uid == request.auth.uid && ticket.sid == sid && ticket.program == program
          && ticket.path == 'schools/' + schoolId + '/uploads/' + sid + '/' + program + '/' + file
          && request.time < ticket.expiresAt
          && request.resource.size > 0 && request.resource.size <= ticket.maxBytes
          && request.resource.contentType == ticket.contentType;
      }
      function registeredStudent() {
        return signedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() == sid
          && firestore.get(/databases/(default)/documents/schools/$(schoolId)/students/$(sid)).data.active == true;
      }
      // 사진·파일·회차별 문장 녹음 모두 서버가 발급한 한 경로에 한 번만 생성.
      // 기존 경로의 녹음은 계속 읽을 수 있다.
      allow create: if registeredStudent() && ticketUpload();
      allow update, delete: if false;
    }

    match /schools/{schoolId}/assets/{file} {
      function staffPath() { return /databases/(default)/documents/schools/$(schoolId)/staff/$(request.auth.uid); }
      allow read: if true;
      allow write: if signedIn()
        && ((firestore.exists(staffPath()) && firestore.get(staffPath()).data.status == 'active' && firestore.get(staffPath()).data.role == 'admin')
            || firestore.exists(/databases/(default)/documents/superAdmins/$(request.auth.uid)))
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
