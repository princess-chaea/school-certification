rules_version = '2';

// 학교별 업로드: schools/{schoolId}/uploads/{학생ID}/... (사진·녹음)
// 학교 로고·직인: schools/{schoolId}/assets/... (공개 읽기)
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    match /schools/{schoolId}/uploads/{sid}/{allPaths=**} {
      function staffPath() { return /databases/(default)/documents/schools/$(schoolId)/staff/$(request.auth.uid); }
      allow read: if (signedIn() && request.auth.token.email.lower() == sid)
        || (signedIn() && firestore.exists(staffPath()) && firestore.get(staffPath()).data.status == 'active');
      allow create, update: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == sid
        && firestore.exists(/databases/(default)/documents/schools/$(schoolId)/students/$(sid))
        && request.resource.size < 12 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
      allow delete: if false;
    }

    match /schools/{schoolId}/assets/{file} {
      function staffPath() { return /databases/(default)/documents/schools/$(schoolId)/staff/$(request.auth.uid); }
      allow read: if true;
      allow write: if signedIn()
        && ((firestore.exists(staffPath()) && firestore.get(staffPath()).data.status == 'active' && firestore.get(staffPath()).data.role == 'admin')
            || firestore.exists(/databases/(default)/documents/superAdmins/$(request.auth.uid)))
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
